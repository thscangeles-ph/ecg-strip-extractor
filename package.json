{
  "name": "ecg-strip-extractor",
  "productName": "ECG Strip Extractor",
  "version": "1.0.2",
  "private": true,
  "description": "Crop the tracing out of an ECG PDF, leave patient details behind, and save it true to scale.",
  "author": "thscangeles-ph",
  "main": "electron/main.js",
  "desktopName": "ecg-strip-extractor.desktop",
  "scripts": {
    "build": "python3 build.py",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.16.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108"
  },
  "build": {
    "appId": "ph.thscangeles.ecgstripextractor",
    "productName": "ECG Strip Extractor",
    "artifactName": "ECG-Strip-Extractor-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/resources/icon.png",
      "dist/ECG-Strip-Extractor.html",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf",
        "rank": "Alternate"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ECG Strip Extractor",
      "artifactName": "ECG-Strip-Extractor-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ECG-Strip-Extractor-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.medical"
    },
    "linux": {
      "executableName": "ecg-strip-extractor",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science",
      "maintainer": "thscangeles-ph",
      "synopsis": "Crop ECG tracings out of PDFs, true to scale",
      "syncDesktopName": true
    }
  }
}
